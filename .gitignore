# --- TERRITORY / local-machine state — NEVER committed ---------------------
# The posture DB is private device/verdict state (the territory), not the spine.
# CI regenerates it each run from cvelistV5 + NVD; it is never the durable artifact.
posture.db
*.db
*.db-journal
*.db-wal
*.db-shm

# cvelistV5 clone lives in CI cache (or ~/.local/share/posture/cvelist), not the repo
cvelist/
cvelistV5/

# Local XDG posture state (~/.local/share/posture + ~/.config/posture)
.local/
.config/posture/

# NVD API key env file (systemd EnvironmentFile) — SECRET, never committed
.env
*.env

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
build/
dist/

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store

# --- Claude Code session state (local only; never committed) ---
.claude/

# --- spine/ is ignored ------------------------------------------------------
# The published map is a build artifact, not source. It is built and signed on
# the serving host and served from there; the repository does not carry it.
# Tracking it here put three gigabytes of generated catalog into every clone
# and into the published history, for an artifact nothing regenerated.
# Do NOT add it here.
# feedback system integration
feedback
learnings

# --- Local workflow scratch (never committed) ---
logs/
